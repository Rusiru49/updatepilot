// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────
// UpdatePilot — database models (from the Week 1 ERD)
// Paste everything below UNDER the generator and datasource
// blocks that `npx prisma init` created in schema.prisma.
// ─────────────────────────────────────────────────────────────

enum Theme {
  LIGHT
  DARK
  SYSTEM
}

enum DeviceStatus {
  ONLINE
  OFFLINE
  REVOKED
}

enum MatchStatus {
  MATCHED
  UNMATCHED
  UNSUPPORTED
}

enum JobState {
  QUEUED
  SENT_TO_AGENT
  RUNNING
  VERIFYING
  SUCCEEDED
  FAILED
  CANCELLED
  RESTART_REQUIRED
}

enum VerificationResult {
  PENDING
  VERIFIED
  MISMATCH
  NOT_CHECKED
}

enum Severity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
  UNKNOWN
}

// People who sign in
model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String
  displayName  String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  settings    UserSettings?
  devices     Device[]
  scanJobs    ScanJob[]
  updateJobs  UpdateJob[]
  auditEvents AuditEvent[]
  sessions    Session[]

  @@map("users")
}

// One settings row per user
model UserSettings {
  userId               String   @id @db.Uuid
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  theme                Theme    @default(SYSTEM)
  autoScanEnabled      Boolean  @default(true)
  scanIntervalHours    Int      @default(24)
  requireConfirmation  Boolean  @default(true)
  notificationsEnabled Boolean  @default(false)
  retentionDays        Int      @default(90)
  updatedAt            DateTime @updatedAt

  @@map("user_settings")
}

// Computers paired with UpdatePilot
model Device {
  id           String       @id @default(uuid()) @db.Uuid
  userId       String       @db.Uuid
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceName   String
  osVersion    String?
  agentVersion String?
  status       DeviceStatus @default(OFFLINE)
  lastSeenAt   DateTime?
  pairedAt     DateTime?
  createdAt    DateTime     @default(now())

  credentials  AgentCredential[]
  applications Application[]
  scanJobs     ScanJob[]
  updateJobs   UpdateJob[]
  auditEvents  AuditEvent[]

  @@index([userId])
  @@map("devices")
}

// Agent keys — only a hash is stored, never the real key
model AgentCredential {
  id             String    @id @default(uuid()) @db.Uuid
  deviceId       String    @db.Uuid
  device         Device    @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  credentialHash String    @unique
  createdAt      DateTime  @default(now())
  expiresAt      DateTime?
  rotatedAt      DateTime?
  revokedAt      DateTime?

  @@index([deviceId])
  @@map("agent_credentials")
}

// Apps found on a device
model Application {
  id               String      @id @default(uuid()) @db.Uuid
  deviceId         String      @db.Uuid
  device           Device      @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  displayName      String
  publisher        String?
  installedVersion String?
  packageId        String?
  source           String?
  matchStatus      MatchStatus @default(UNMATCHED)
  firstSeenAt      DateTime    @default(now())
  lastSeenAt       DateTime    @default(now())

  updateJobs UpdateJob[]
  snapshots  AppSnapshot[]

  @@index([deviceId])
  @@index([packageId])
  @@map("applications")
}

// Each scan of a device
model ScanJob {
  id            String    @id @default(uuid()) @db.Uuid
  deviceId      String    @db.Uuid
  device        Device    @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  requestedById String?   @db.Uuid
  requestedBy   User?     @relation(fields: [requestedById], references: [id], onDelete: SetNull)
  state         JobState  @default(QUEUED)
  appsFound     Int?
  startedAt     DateTime?
  finishedAt    DateTime?
  errorSummary  String?
  createdAt     DateTime  @default(now())

  snapshots AppSnapshot[]

  @@index([deviceId, createdAt])
  @@map("scan_jobs")
}

// Version of each app at each scan (history is kept, not overwritten)
model AppSnapshot {
  id            String      @id @default(uuid()) @db.Uuid
  scanJobId     String      @db.Uuid
  scanJob       ScanJob     @relation(fields: [scanJobId], references: [id], onDelete: Cascade)
  applicationId String      @db.Uuid
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  version       String
  recordedAt    DateTime    @default(now())

  @@unique([scanJobId, applicationId])
  @@map("app_snapshots")
}

// Each update attempt
model UpdateJob {
  id                 String             @id @default(uuid()) @db.Uuid
  applicationId      String             @db.Uuid
  application        Application        @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  deviceId           String             @db.Uuid
  device             Device             @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  requestedById      String?            @db.Uuid
  requestedBy        User?              @relation(fields: [requestedById], references: [id], onDelete: SetNull)
  fromVersion        String
  targetVersion      String
  state              JobState           @default(QUEUED)
  idempotencyKey     String             @unique
  exitCode           Int?
  verifiedVersion    String?
  verificationResult VerificationResult @default(PENDING)
  errorMessage       String?
  createdAt          DateTime           @default(now())
  confirmedAt        DateTime?
  startedAt          DateTime?
  finishedAt         DateTime?

  @@index([deviceId, createdAt])
  @@map("update_jobs")
}

// Available versions and release info (cached from trusted sources)
model ReleaseMetadata {
  id           String    @id @default(uuid()) @db.Uuid
  packageId    String
  version      String
  channel      String?
  releaseDate  DateTime? @db.Date
  changelogUrl String?
  source       String
  fetchedAt    DateTime  @default(now())

  @@unique([packageId, version, source])
  @@index([packageId])
  @@map("release_metadata")
}

// Verified security advisories (e.g. from OSV)
model SecurityFinding {
  id             String   @id @default(uuid()) @db.Uuid
  packageId      String
  advisoryId     String
  severity       Severity @default(UNKNOWN)
  affectedRange  String?
  source         String
  lastVerifiedAt DateTime

  @@unique([packageId, advisoryId])
  @@index([packageId])
  @@map("security_findings")
}

// Who did what, on which device, and when
model AuditEvent {
  id          String   @id @default(uuid()) @db.Uuid
  actorUserId String?  @db.Uuid
  actor       User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  deviceId    String?  @db.Uuid
  device      Device?  @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  eventType   String
  targetType  String?
  targetId    String?  @db.Uuid
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@map("audit_events")
}

// Login sessions — only a hash of the session token is stored
model Session {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([userId])
  @@map("sessions")
}
